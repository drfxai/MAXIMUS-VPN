diff -ruN a/dnstt-server/domains_test.go b/dnstt-server/domains_test.go
--- a/dnstt-server/domains_test.go
+++ b/dnstt-server/domains_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"testing"
+
+	"www.bamsoftware.com/git/dnstt.git/dns"
+)
+
+func TestAnswersEveryTunnelDomain(t *testing.T) {
+	var domains []dns.Name
+	for _, s := range []string{"t.example.com", "u.example.net"} {
+		d, _ := dns.ParseName(s)
+		domains = append(domains, d)
+	}
+	for _, tc := range []struct {
+		name  string
+		rcode uint16
+	}{
+		{"aaaaaaaaaaaaaaaa.t.example.com", dns.RcodeNoError},
+		{"aaaaaaaaaaaaaaaa.u.example.net", dns.RcodeNoError},
+		{"aaaaaaaaaaaaaaaa.example.org", dns.RcodeNameError},
+	} {
+		name, err := dns.ParseName(tc.name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		query := &dns.Message{
+			Flags:      0x0100,
+			Question:   []dns.Question{{Name: name, Type: dns.RRTypeTXT, Class: dns.ClassIN}},
+			Additional: []dns.RR{{Type: dns.RRTypeOPT, Class: 4096}},
+		}
+		resp, _ := responseFor(query, domains)
+		if resp == nil || resp.Flags&0x000f != tc.rcode {
+			t.Fatalf("%s: got %v, want rcode %d", tc.name, resp, tc.rcode)
+		}
+	}
+}
