 }
+
+// Only add delay. Subtractive jitter would violate the configured QPS ceiling.
+func jitterDelay(interval time.Duration) time.Duration {
+    if interval <= 0 { return 0 }
+    var b [8]byte
+    if _, err := rand.Read(b[:]); err != nil { return interval / 8 }
+    return time.Duration(binary.LittleEndian.Uint64(b[:]) % (uint64(interval / 4) + 1))
+}
