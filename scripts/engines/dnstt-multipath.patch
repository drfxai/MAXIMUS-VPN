diff -ruN a/dnstt-client/pool.go b/dnstt-client/pool.go
--- a/dnstt-client/pool.go
+++ b/dnstt-client/pool.go
@@ -0,0 +1,182 @@
+package main
+
+import (
+	"log"
+	"net"
+	"sync"
+	"time"
+
+	"www.bamsoftware.com/git/dnstt.git/dns"
+)
+
+// Health rules for resolvers and tunnel domains. A resolver or a domain is
+// judged only by whether good tunnel answers come back, never by a single
+// error or a "name does not exist" (NXDOMAIN) answer: some networks inject
+// fake NXDOMAIN answers, and on UDP the real answer still arrives after the
+// fake one.
+const (
+	// A resolver that has had this many queries and this much time without a
+	// good answer is set aside for a while.
+	resolverFailQueries = 8
+	resolverFailTime    = 10 * time.Second
+	// How long a failing resolver is set aside: doubling from the first value
+	// up to the second. When the time is up it gets another chance.
+	benchFirst = 30 * time.Second
+	benchMax   = 5 * time.Minute
+	// The client moves to the next tunnel domain when the current one has had
+	// this many queries and this much time with no good answer through any
+	// resolver.
+	domainFailQueries = 12
+	domainFailTime    = 15 * time.Second
+)
+
+// resolver is one DNS resolver the client sends queries through.
+type resolver struct {
+	name      string
+	transport net.PacketConn
+	addr      net.Addr
+	// pacer is this resolver's own when the rate limit counts per resolver,
+	// and shared by all resolvers otherwise.
+	pacer *queryPacer
+
+	// Health, guarded by pool.lock.
+	judgedSince  time.Time
+	sinceGood    int
+	benchedUntil time.Time
+	benchFor     time.Duration
+	nxdomain     int
+}
+
+// pool picks a resolver and a tunnel domain for every query, sets aside
+// resolvers that stop answering, and moves to a backup domain when the current
+// one stops answering.
+type pool struct {
+	lock        sync.Mutex
+	now         func() time.Time
+	resolvers   []*resolver
+	perResolver bool
+	next        int
+	domains     []dns.Name
+	active      int
+	// Since when, and over how many queries, the active domain has gone
+	// without a good answer.
+	domainSince time.Time
+	domainSent  int
+}
+
+func newPool(resolvers []*resolver, domains []dns.Name, perResolver bool, now func() time.Time) *pool {
+	t := now()
+	for _, r := range resolvers {
+		r.judgedSince = t
+		r.benchFor = benchFirst
+	}
+	return &pool{now: now, resolvers: resolvers, perResolver: perResolver, domains: domains, domainSince: t}
+}
+
+// pick returns the resolver and the domain for the next query and counts the
+// query against both.
+func (p *pool) pick() (*resolver, dns.Name) {
+	p.lock.Lock()
+	defer p.lock.Unlock()
+	t := p.now()
+
+	var chosen *resolver
+	if p.perResolver {
+		// Each resolver has its own limit: use the one that may send soonest.
+		for _, r := range p.usable(t) {
+			if chosen == nil || r.pacer.ready().Before(chosen.pacer.ready()) {
+				chosen = r
+			}
+		}
+	} else {
+		usable := p.usable(t)
+		chosen = usable[p.next%len(usable)]
+		p.next++
+	}
+	chosen.sinceGood++
+
+	p.domainSent++
+	if len(p.domains) > 1 && p.domainSent >= domainFailQueries && t.Sub(p.domainSince) >= domainFailTime {
+		p.active = (p.active + 1) % len(p.domains)
+		log.Printf("no answer through domain %s in %d queries; switching to %s",
+			p.domains[(p.active+len(p.domains)-1)%len(p.domains)], p.domainSent, p.domains[p.active])
+		p.domainSince = t
+		p.domainSent = 0
+	}
+	return chosen, p.domains[p.active]
+}
+
+// usable returns the resolvers not set aside, setting aside any that just
+// failed and bringing back any whose time is up. It never returns an empty
+// list: when every resolver is set aside, the one due back soonest is used.
+func (p *pool) usable(t time.Time) []*resolver {
+	var out []*resolver
+	var soonest *resolver
+	for _, r := range p.resolvers {
+		if !r.benchedUntil.IsZero() && t.Before(r.benchedUntil) {
+			if soonest == nil || r.benchedUntil.Before(soonest.benchedUntil) {
+				soonest = r
+			}
+			continue
+		}
+		if !r.benchedUntil.IsZero() {
+			// Back from the bench: judged afresh.
+			r.benchedUntil = time.Time{}
+			r.judgedSince = t
+			r.sinceGood = 0
+		}
+		if len(p.resolvers) > 1 && r.sinceGood >= resolverFailQueries && t.Sub(r.judgedSince) >= resolverFailTime {
+			r.benchedUntil = t.Add(r.benchFor)
+			log.Printf("resolver %s: no answer in %d queries; resting it for %v", r.name, r.sinceGood, r.benchFor)
+			r.benchFor *= 2
+			if r.benchFor > benchMax {
+				r.benchFor = benchMax
+			}
+			if soonest == nil || r.benchedUntil.Before(soonest.benchedUntil) {
+				soonest = r
+			}
+			continue
+		}
+		out = append(out, r)
+	}
+	if len(out) == 0 {
+		out = append(out, soonest)
+	}
+	return out
+}
+
+// good records a good tunnel answer from r for domain index d.
+func (p *pool) good(r *resolver, d int) {
+	p.lock.Lock()
+	defer p.lock.Unlock()
+	t := p.now()
+	r.judgedSince = t
+	r.sinceGood = 0
+	r.benchFor = benchFirst
+	if d == p.active {
+		p.domainSince = t
+		p.domainSent = 0
+	}
+}
+
+// nameError records an NXDOMAIN answer. It is logged, never held against the
+// resolver.
+func (p *pool) nameError(r *resolver) {
+	p.lock.Lock()
+	r.nxdomain++
+	n := r.nxdomain
+	p.lock.Unlock()
+	if n == 1 || n%100 == 0 {
+		log.Printf("resolver %s: %d \"name does not exist\" answers so far (ignored)", r.name, n)
+	}
+}
+
+// domainIndex returns the index of the tunnel domain name is under, or -1.
+func (p *pool) domainIndex(name dns.Name) int {
+	for i, d := range p.domains {
+		if _, ok := name.TrimSuffix(d); ok {
+			return i
+		}
+	}
+	return -1
+}
diff -ruN a/dnstt-client/pool_test.go b/dnstt-client/pool_test.go
--- a/dnstt-client/pool_test.go
+++ b/dnstt-client/pool_test.go
@@ -0,0 +1,156 @@
+package main
+
+import (
+	"testing"
+	"time"
+
+	"www.bamsoftware.com/git/dnstt.git/dns"
+)
+
+type fakeClock struct{ t time.Time }
+
+func (c *fakeClock) now() time.Time { return c.t }
+
+func testPool(t *testing.T, n int, domains []string, perResolver bool) (*pool, *fakeClock) {
+	clock := &fakeClock{time.Unix(1_800_000_000, 0)}
+	shared := newQueryPacer(0)
+	var rs []*resolver
+	for i := 0; i < n; i++ {
+		pacer := shared
+		if perResolver {
+			pacer = newQueryPacer(0)
+		}
+		rs = append(rs, &resolver{name: string(rune('a' + i)), pacer: pacer})
+	}
+	var ds []dns.Name
+	for _, s := range domains {
+		d, err := dns.ParseName(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ds = append(ds, d)
+	}
+	return newPool(rs, ds, perResolver, clock.now), clock
+}
+
+// send makes count queries, one every step, and returns how many went through each resolver.
+func send(p *pool, clock *fakeClock, count int, step time.Duration, answer func(*resolver, dns.Name) bool) map[string]int {
+	used := map[string]int{}
+	for i := 0; i < count; i++ {
+		r, d := p.pick()
+		used[r.name]++
+		if answer(r, d) {
+			p.good(r, p.domainIndex(d))
+		}
+		clock.t = clock.t.Add(step)
+	}
+	return used
+}
+
+func TestQueriesSpreadOverResolvers(t *testing.T) {
+	p, clock := testPool(t, 3, []string{"t.example.com"}, false)
+	used := send(p, clock, 30, 250*time.Millisecond, func(*resolver, dns.Name) bool { return true })
+	for _, name := range []string{"a", "b", "c"} {
+		if used[name] != 10 {
+			t.Fatalf("resolver %s got %d of 30 queries, want 10: %v", name, used[name], used)
+		}
+	}
+}
+
+func TestSilentResolverIsRestedAndComesBack(t *testing.T) {
+	p, clock := testPool(t, 2, []string{"t.example.com"}, false)
+	// Resolver b never answers.
+	used := send(p, clock, 80, 250*time.Millisecond, func(r *resolver, _ dns.Name) bool { return r.name == "a" })
+	// It is judged after resolverFailTime: at 2 queries a second, about 20 queries.
+	if used["b"] > int(resolverFailTime/(500*time.Millisecond))+2 {
+		t.Fatalf("silent resolver b kept getting queries: %v", used)
+	}
+	// After its rest it gets another chance.
+	clock.t = clock.t.Add(benchFirst)
+	used = send(p, clock, 4, 250*time.Millisecond, func(r *resolver, _ dns.Name) bool { return true })
+	if used["b"] == 0 {
+		t.Fatalf("rested resolver b never came back: %v", used)
+	}
+}
+
+func TestNameErrorsAreNotHeldAgainstAResolver(t *testing.T) {
+	p, clock := testPool(t, 2, []string{"t.example.com"}, false)
+	// b gets a fake NXDOMAIN for every query, and the real answer after it.
+	used := send(p, clock, 80, 250*time.Millisecond, func(r *resolver, _ dns.Name) bool {
+		if r.name == "b" {
+			p.nameError(r)
+		}
+		return true
+	})
+	if used["b"] != 40 {
+		t.Fatalf("resolver b was set aside over NXDOMAIN answers: %v", used)
+	}
+}
+
+func TestEveryResolverSilentStillSends(t *testing.T) {
+	p, clock := testPool(t, 2, []string{"t.example.com"}, false)
+	used := send(p, clock, 200, 250*time.Millisecond, func(*resolver, dns.Name) bool { return false })
+	if used["a"]+used["b"] != 200 {
+		t.Fatalf("queries were lost: %v", used)
+	}
+}
+
+func TestBlockedDomainSwitchesToBackup(t *testing.T) {
+	p, clock := testPool(t, 1, []string{"t.example.com", "t.example.net"}, false)
+	backup := 0
+	send(p, clock, 200, 250*time.Millisecond, func(_ *resolver, d dns.Name) bool {
+		if d.String() == "t.example.net" {
+			backup++
+			return true
+		}
+		return false
+	})
+	if p.active != 1 {
+		t.Fatalf("still on domain %d, want the backup", p.active)
+	}
+	// About 15 s at 4 a second on the blocked domain, then the backup only.
+	if backup < 200-int(domainFailTime/(250*time.Millisecond))-2 {
+		t.Fatalf("only %d of 200 queries used the backup domain", backup)
+	}
+}
+
+func TestWorkingDomainIsKept(t *testing.T) {
+	p, clock := testPool(t, 1, []string{"t.example.com", "t.example.net"}, false)
+	send(p, clock, 200, 250*time.Millisecond, func(*resolver, dns.Name) bool { return true })
+	if p.active != 0 {
+		t.Fatalf("moved off a working domain to %d", p.active)
+	}
+}
+
+func TestPerResolverLimitUsesTheReadiestResolver(t *testing.T) {
+	clock := &fakeClock{time.Unix(1_800_000_000, 0)}
+	rs := []*resolver{{name: "a", pacer: newQueryPacer(4)}, {name: "b", pacer: newQueryPacer(4)}}
+	d, _ := dns.ParseName("t.example.com")
+	p := newPool(rs, []dns.Name{d}, true, clock.now)
+	start := time.Now()
+	used := map[string]int{}
+	for i := 0; i < 9; i++ {
+		r, _ := p.pick()
+		r.pacer.wait()
+		used[r.name]++
+	}
+	// Two resolvers at 4 a second each: 9 queries take about 1 s, not 2.
+	if elapsed := time.Since(start); elapsed > 1500*time.Millisecond || elapsed < 950*time.Millisecond {
+		t.Fatalf("9 queries over two resolvers at 4/s each took %v", elapsed)
+	}
+	if used["a"] < 4 || used["b"] < 4 {
+		t.Fatalf("queries not shared: %v", used)
+	}
+}
+
+func TestBackupDomainsAcceptAnswers(t *testing.T) {
+	p, _ := testPool(t, 1, []string{"t.example.com", "u.example.org"}, false)
+	n, _ := dns.ParseName("abc.u.example.org")
+	if p.domainIndex(n) != 1 {
+		t.Fatal("answer under the backup domain not recognised")
+	}
+	n, _ = dns.ParseName("abc.example.org")
+	if p.domainIndex(n) != -1 {
+		t.Fatal("answer outside the tunnel domains accepted")
+	}
+}
diff -ruN a/dnstt-client/querypace.go b/dnstt-client/querypace.go
--- a/dnstt-client/querypace.go
+++ b/dnstt-client/querypace.go
@@ -44,3 +44,10 @@
 	p.lock.Unlock()
 	time.Sleep(time.Until(at))
 }
+
+// ready returns the earliest time the next query may be sent.
+func (p *queryPacer) ready() time.Time {
+	p.lock.Lock()
+	defer p.lock.Unlock()
+	return p.next
+}
